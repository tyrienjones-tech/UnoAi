#!/usr/bin/env bash
# UnoAi pre-commit hook — five-step chain (per DEC-024 / DEC-026 / DEC-027 /
# MS-006 Scope F3 / DEC-033).
#
# Order (fail-fast — one tool's failure aborts the rest):
#   1. gitleaks scan staged content (DEC-024 / Procedure 8) — secrets first.
#   2. scripts/validate.sh structural-integrity check (DEC-026 / Procedure 9).
#   3. Prettier --check on staged files (formatting).
#   4. ESLint on staged files (semantics + naming conventions per DEC-027).
#   5. cspell on staged .md files (spelling per DEC-033 / MS-008 Scope B4).
# All five must exit 0 for the commit to proceed.
#
# Setup (one-time per clone):
#   git config core.hooksPath .githooks
#
# Bypass (for emergencies only — file an INCIDENT if used):
#   git commit --no-verify
#
# Builder discipline: never use --no-verify silently. If gitleaks is wrong,
# extend .gitleaks.toml allowlist OR rotate the secret OR update INCIDENT log
# with redacted detail. If the validator is wrong, fix the structural drift
# OR update scripts/validate.sh AND its tests.

set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] FAIL: gitleaks not on PATH." >&2
  echo "  Install:" >&2
  echo "    Windows : download gitleaks_*_windows_x64.zip from" >&2
  echo "              https://github.com/gitleaks/gitleaks/releases" >&2
  echo "              then place gitleaks.exe in a directory on PATH." >&2
  echo "    macOS   : brew install gitleaks" >&2
  echo "    Linux   : see https://github.com/gitleaks/gitleaks#installing" >&2
  echo "" >&2
  echo "  Per DEC-024, the secrets-scan hook is required. The commit is blocked." >&2
  exit 1
fi

if [ ! -f ".gitleaks.toml" ]; then
  echo "[pre-commit] FAIL: .gitleaks.toml missing at repo root." >&2
  echo "  Per DEC-024, the project's gitleaks config must exist before committing." >&2
  exit 1
fi

echo "[pre-commit] gitleaks scanning staged content..."
if ! gitleaks protect --staged --config .gitleaks.toml --redact --verbose; then
  echo "" >&2
  echo "[pre-commit] FAIL: gitleaks flagged a potential secret in staged content." >&2
  echo "" >&2
  echo "Required actions (per DEC-024):" >&2
  echo "  1. Treat the matched content as compromised — rotate at source immediately." >&2
  echo "  2. Remove the content from the staged diff (do NOT --no-verify)." >&2
  echo "  3. File an INCIDENT entry with redacted detail (DEC-024 / Procedure 8)." >&2
  echo "  4. If the rule is a false positive, extend .gitleaks.toml allowlist." >&2
  echo "" >&2
  echo "Commit blocked." >&2
  exit 1
fi

echo "[pre-commit] gitleaks: clean."

# Step 2: structural-integrity validator (DEC-026 / Procedure 9).
if [ ! -f "scripts/validate.sh" ]; then
  echo "[pre-commit] FAIL: scripts/validate.sh missing at repo root." >&2
  echo "  Per DEC-026, the structural validator is required. The commit is blocked." >&2
  exit 1
fi

echo "[pre-commit] running scripts/validate.sh..."
if ! bash scripts/validate.sh; then
  echo "" >&2
  echo "[pre-commit] FAIL: structural validator flagged an integrity issue." >&2
  echo "" >&2
  echo "Required actions (per DEC-026):" >&2
  echo "  1. Read the validator output above — each FAIL line names the specific issue." >&2
  echo "  2. Fix the underlying drift (numbering gap, missing cross-reference, stale state counter, missing session-end, etc.)." >&2
  echo "  3. Re-run 'bash scripts/validate.sh' until VALIDATOR: PASS." >&2
  echo "  4. Do NOT --no-verify. The drift is real; bypassing it leaves it for the next session." >&2
  echo "" >&2
  echo "Commit blocked." >&2
  exit 1
fi

# Step 3 + 4: Prettier --check + ESLint on staged files (per MS-006 Scope F3 +
# DEC-027). Both run on the staged set only — extracted via
# `git diff --cached --name-only --diff-filter=ACMR`. Files that don't exist
# anymore (D = deleted, R = renamed handled separately) are filtered out.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|js|svelte|svelte\.js|svelte\.ts|css|html|json)$' || true)

if [ -n "$STAGED_FILES" ]; then
  echo "[pre-commit] running Prettier --check on staged files..."
  if ! npx prettier --check $STAGED_FILES; then
    echo "" >&2
    echo "[pre-commit] FAIL: Prettier flagged staged files with formatting issues." >&2
    echo "  Fix:  npm run format    # writes Prettier-formatted output to all files" >&2
    echo "        git add <files>   # re-stage" >&2
    echo "" >&2
    echo "Commit blocked." >&2
    exit 1
  fi
  echo "[pre-commit] Prettier: clean."

  echo "[pre-commit] running ESLint on staged files..."
  if ! npx eslint $STAGED_FILES; then
    echo "" >&2
    echo "[pre-commit] FAIL: ESLint flagged staged files with rule violations." >&2
    echo "  Fix:  npm run lint              # see violations" >&2
    echo "        npx eslint --fix <files>  # auto-fix what's auto-fixable" >&2
    echo "        # then manually fix the rest, re-stage, retry commit" >&2
    echo "" >&2
    echo "Commit blocked." >&2
    exit 1
  fi
  echo "[pre-commit] ESLint: clean."
else
  echo "[pre-commit] no staged code files for Prettier/ESLint."
fi

# Step 5: cspell on staged .md files (per MS-008 Scope B4 + DEC-033).
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.md$' || true)
if [ -n "$STAGED_MD" ]; then
  echo "[pre-commit] running cspell on staged .md files..."
  if ! npx cspell --no-summary $STAGED_MD; then
    echo "" >&2
    echo "[pre-commit] FAIL: cspell flagged staged .md files." >&2
    echo "  Fix:" >&2
    echo "    - Real typos: correct in source." >&2
    echo "    - Project terms: add to .cspell.json 'words' array." >&2
    echo "    - npm run spell-check  # re-run across all .md files" >&2
    echo "" >&2
    echo "Commit blocked." >&2
    exit 1
  fi
  echo "[pre-commit] cspell: clean."
else
  echo "[pre-commit] no staged .md files for cspell."
fi

exit 0
