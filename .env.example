# UnoAi — environment variables
#
# Copy this file to .env.local for development.
# Cloudflare Workers production secrets live in the
# Worker dashboard, not in any .env file.
#
# NEVER commit .env or .env.local. Both are gitignored
# and gitleaks will block any commit containing the
# patterns below with real values.

# === Lemon Squeezy ===
# Webhook signing secret — provided by LS at webhook
# configuration time. Used to verify incoming webhooks.
LEMON_SQUEEZY_WEBHOOK_SECRET=replace_with_real_secret

# === License signing (Ed25519) ===
# Private key — generate via:
#   openssl genpkey -algorithm ed25519 -out private.pem
# Then base64-encode for env var.
# Public key ships in client code (src/lib/auth/) per
# DEC-007.
# NEVER commit the private key. Worker secret only.
LICENSE_PRIVATE_KEY=replace_with_base64_ed25519_private_key

# === Anthropic (crisis classifier — Phase 6) ===
# NOT used by the Worker directly. User's BYOK key is
# passed from client at request time. This is reserved
# for any server-side classifier work post-MVP per
# DEC-020.
# Leave unset until Phase 6 implementation.
# ANTHROPIC_API_KEY=
